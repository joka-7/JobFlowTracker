rules_version = '2';

// Firestore is no longer used: data syncs only to each user's own Google Drive
// (src/driveSync.js). Deny everything so the old project can't hold or serve
// anyone's data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
